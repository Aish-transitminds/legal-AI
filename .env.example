APP_ENV=development
APP_NAME=Legal Document Intelligence
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=15
RETENTION_DAYS=30
LLM_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Choose ollama, openrouter, or groq.
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Optional remote provider. Keep secrets server-side and leave blank by default.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# PostgreSQL is the target deployment database for Phase 2.
DATABASE_URL=postgresql+psycopg://legal_ai:change-me@localhost:5432/legal_ai
